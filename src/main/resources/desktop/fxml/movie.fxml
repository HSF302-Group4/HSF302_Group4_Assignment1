<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fu.cinema.desktop.controller.MovieController"
            fx:id="root" styleClass="page">
    <top>
        <VBox spacing="12" style="-fx-padding: 0 0 12 0;">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <Label text="DANH SÁCH PHIM" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCount" style="-fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
                <Button text="Thêm phim" onAction="#onAdd" styleClass="primary"/>
                <Button text="Làm mới" onAction="#onRefresh"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Tìm:"/>
                <TextField fx:id="tfSearch" promptText="Tìm theo tên phim..." prefWidth="180"/>

                <Label text="Thể loại:"/>
                <ComboBox fx:id="cbGenre" prefWidth="160" promptText="Tất cả"/>

                <Label text="Trạng thái:"/>
                <ComboBox fx:id="cbStatus" prefWidth="140" promptText="Tất cả"/>

                <Label text="Sắp xếp:"/>
                <ComboBox fx:id="cbSort" prefWidth="160"/>

                <Button text="Đặt lại" onAction="#onResetFilters"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="colId" text="Mã" prefWidth="60"/>
                <TableColumn fx:id="colTitle" text="Tên phim" prefWidth="220"/>
                <TableColumn fx:id="colGenre" text="Thể loại" prefWidth="130"/>
                <TableColumn fx:id="colDuration" text="Thời lượng" prefWidth="100"/>
                <TableColumn fx:id="colRelease" text="Khởi chiếu" prefWidth="110"/>
                <TableColumn fx:id="colAgeRating" text="Độ tuổi" prefWidth="75"/>
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 8 0 0 0;">
            <Pagination fx:id="pagination" maxPageIndicatorCount="7"/>
        </HBox>
    </bottom>
</BorderPane>