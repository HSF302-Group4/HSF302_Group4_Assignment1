<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fu.cinema.desktop.controller.DashboardController"
      spacing="16" styleClass="page">

    <HBox spacing="16" alignment="CENTER_LEFT">
        <Label text="DASHBOARD — TỔNG QUAN" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblUpdated" style="-fx-text-fill: #6b7280; -fx-font-style: italic;"/>
        <Button fx:id="btnRefresh" text="Làm mới" onAction="#refresh"/>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="kpi" HBox.hgrow="ALWAYS">
            <Label text="Phim đang chiếu" styleClass="kpi-title"/>
            <Label fx:id="lblShowing" text="0" styleClass="kpi-value"/>
        </VBox>
        <VBox styleClass="kpi" HBox.hgrow="ALWAYS">
            <Label text="Khách hàng" styleClass="kpi-title"/>
            <Label fx:id="lblCustomers" text="0" styleClass="kpi-value"/>
        </VBox>
        <VBox styleClass="kpi" HBox.hgrow="ALWAYS">
            <Label text="Đơn chờ duyệt (PENDING)" styleClass="kpi-title"/>
            <Label fx:id="lblPending" text="0" styleClass="kpi-value"/>
        </VBox>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" spacing="8" styleClass="chart-card">
        <Label text="Suất chiếu hôm nay theo phòng" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
        <BarChart fx:id="chartRooms" VBox.vgrow="ALWAYS" legendVisible="false">
            <xAxis>
                <CategoryAxis label="Phòng chiếu"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Số suất" minorTickVisible="false"/>
            </yAxis>
        </BarChart>
    </VBox>
</VBox>
