<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fu.cinema.desktop.controller.BookingAdminController"
            styleClass="page">
    <top>
        <VBox spacing="12" style="-fx-padding: 0 0 12 0;">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="QUẢN LÝ ĐƠN ĐẶT VÉ" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnConfirm" text="Xác nhận đơn" onAction="#onConfirm" styleClass="primary"/>
                <Button fx:id="btnCancel" text="Huỷ đơn" onAction="#onCancel"/>
                <Button fx:id="btnRefresh" text="Làm mới" onAction="#onRefresh"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Trạng thái:"/>
                <ComboBox fx:id="cbStatus" prefWidth="140" promptText="Tất cả"/>

                <Label text="Từ ngày:"/>
                <DatePicker fx:id="dpFrom" prefWidth="135"/>

                <Label text="Đến ngày:"/>
                <DatePicker fx:id="dpTo" prefWidth="135"/>

                <Label text="Khách hàng:"/>
                <TextField fx:id="tfKeyword" promptText="Tên / SĐT / Email..." prefWidth="180"/>

                <Button text="Lọc" onAction="#onSearch" styleClass="primary"/>
                <Button text="Đặt lại" onAction="#onResetFilters"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table" styleClass="booking-table">
            <columns>
                <TableColumn fx:id="colId" text="Mã đơn" prefWidth="75"/>
                <TableColumn fx:id="colCustomer" text="Khách hàng" prefWidth="140"/>
                <TableColumn fx:id="colMovie" text="Phim" prefWidth="160"/>
                <TableColumn fx:id="colRoom" text="Phòng" prefWidth="90"/>
                <TableColumn fx:id="colStart" text="Suất chiếu" prefWidth="130"/>
                <TableColumn fx:id="colSeats" text="Số vé" prefWidth="65"/>
                <TableColumn fx:id="colTotal" text="Tổng tiền" prefWidth="110"/>
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110"/>
                <TableColumn fx:id="colDate" text="Ngày đặt" prefWidth="130"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 8 0 0 0;">
            <Pagination fx:id="pagination" maxPageIndicatorCount="7"/>
        </HBox>
    </bottom>
</BorderPane>
