<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fu.cinema.desktop.controller.ScheduleController"
            styleClass="page">
    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 0 0 16 0;">
            <Label text="QUẢN LÝ PHÒNG &amp; SUẤT CHIẾU" styleClass="page-title"/>
        </HBox>
    </top>

    <center>
        <VBox fx:id="formBox" spacing="12" maxWidth="450" style="-fx-padding: 16;">
            <Label text="Thêm / Cập nhật suất chiếu" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Label text="Phim:"/>
            <ComboBox fx:id="cbMovie" promptText="-- Chọn phim --" maxWidth="Infinity"/>

            <Label text="Phòng chiếu:"/>
            <ComboBox fx:id="cbRoom" promptText="-- Chọn phòng --" maxWidth="Infinity"/>

            <Label text="Ngày chiếu:"/>
            <DatePicker fx:id="dpDate" maxWidth="Infinity"/>

            <Label text="Giờ bắt đầu:"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Spinner fx:id="spHour" prefWidth="90"/>
                <Label text="giờ"/>
                <Spinner fx:id="spMinute" prefWidth="90"/>
                <Label text="phút"/>
            </HBox>

            <Label fx:id="lblEnd" style="-fx-text-fill: #4b5563; -fx-font-style: italic;"/>

            <Label text="Giá vé (VNĐ):"/>
            <TextField fx:id="tfPrice" promptText="Nhập giá vé"/>

            <Button text="Lưu suất chiếu" onAction="#onSaveShowtime" styleClass="primary" maxWidth="Infinity"/>
        </VBox>
    </center>
</BorderPane>
